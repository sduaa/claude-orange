{
  "name": "claude-orange",
  "description": "Claude Orange theme for the dsh web GUI: warm terracotta and parchment palette, light + dark variants, serif UI (Source Han Serif), mono code, adaptive chat column width.",
  "version": "1.0.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "devDependencies": {
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "@deepseek-ai/cordis": "4.0.2"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skin.json",
    "README.md"
  ]
}
